---
import Layout from '../layouts/Layout.astro';
import Lottie from '../components/Lottie.vue';
import Navigation from '../components/Navigation.vue';

import Card from '../components/Card.astro';
import ScrollContent from '../components/ScrollContent.vue';
import { loadQuery } from '@lib/loadQuery'
import { homeQuery } from '@/query/home'
import { type Home } from '@sanity/types'
const { data: home } = await loadQuery<Home>({
  query: homeQuery
})
---

<Layout title={home.seo?.title as string}>
	
	<ScrollContent
		type='secondary' 
		client:load
	>
		<!-- <TailwindWrapper> -->
			<Navigation/>
		<!-- </TailwindWrapper> -->
	</ScrollContent>
	<Lottie path='youtube.json' client:only/>
</Layout>
